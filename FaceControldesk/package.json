{
	"name": "facecontrol",
	"version": "1.3.0",
	"description": "FaceID — maktablar uchun yuz-nazorat tizimi (desktop mijoz)",
	"author": "Egamberdiyev Sarvar",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder --win"
	},
	"build": {
		"appId": "uz.facecontrol.app",
		"productName": "FaceControl",
		"asar": true,
		"directories": {
			"buildResources": "assets",
			"output": "dist"
		},
		"files": [
			"**/*",
			"!dist{,/**/*}",
			"!node_modules/.cache{,/**/*}"
		],
		"win": {
			"icon": "assets/icon.ico",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"ia32"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"allowToChangeInstallationDirectory": true,
			"installerIcon": "assets/icon.ico",
			"uninstallerIcon": "assets/icon.ico",
			"installerHeaderIcon": "assets/icon.ico",
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "FaceControl"
		},
		"publish": [
			{
				"provider": "generic",
				"url": "https://faceid-paxtachi.uz/desktop/"
			}
		]
	},
	"devDependencies": {
		"electron": "^32.0.0",
		"electron-builder": "^24.13.3"
	},
	"dependencies": {
		"electron-store": "^8.1.0",
		"electron-updater": "^6.6.2"
	},
	"license": "ISC",
	"type": "commonjs"
}
