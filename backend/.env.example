# ===== backend/.env — faqat shular kerak. Qolgan hamma sozlama tizim egasi panelidan (Platforma sozlamalari, AI sozlamalari, Tumanlar...) =====

# Server rejimi: district = TUMAN serveri (maktablar, kameralar, AI, davomat), region = VILOYAT serveri (tumanlardan o'qiydi)
APP_MODE=district

# Server porti va baza manzili (har server o'z bazasi bilan: tuman bazasi, viloyat bazasi alohida)
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/faceid

# Frontend manzili: backend shu manzildan kelgan so'rovlarni qabul qiladi (CORS). Bir nechta bo'lsa vergul bilan.
# Developmentda hamma manzil ruxsat; productionda (NODE_ENV=production) faqat shu manzillar.
FRONTEND_URL=http://localhost:5173

# Maxfiy kalit (kamida 32 belgi, tasodifiy, har serverda ALOHIDA): kirish tokenlari va saqlanadigan kalitlarni shifrlash uchun
JWT_SECRET=BU_YERGA_TASODIFIY_UZUN_QATOR

# --- Production (ixtiyoriy) ---
# NODE_ENV=production
# TRUST_PROXY=1            # Nginx ortida ishlasa
# HIK_SECRETS_KEY=...      # Hik/tuman kalitlarini shifrlash uchun alohida kalit (bo'lmasa JWT_SECRET ishlatiladi)
