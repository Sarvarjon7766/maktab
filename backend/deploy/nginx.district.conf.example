# TUMAN serveri uchun nginx (viloyat serveri uchun ham shu shablon, faqat domen va `federation` bloki farq qiladi)
# Sertifikat: certbot --nginx -d tuman.example.uz
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

server {
    listen 80;
    server_name tuman.example.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tuman.example.uz;

    ssl_certificate     /etc/letsencrypt/live/tuman.example.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tuman.example.uz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 25m;       # rasm/Excel yuklash
    server_tokens off;

    # Frontend (npm run build natijasi)
    root /var/www/faceid/dist;
    index index.html;
    location / { try_files $uri /index.html; }

    # API
    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://127.0.0.1:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # Federatsiya API (faqat VILOYAT serveri manzilidan). Boshqalar uchun yopiq: kalit bo'lsa ham IP bo'yicha rad etiladi
    location /api/federation/ {
        allow 203.0.113.10;         # viloyat serverining IP manzili
        deny all;
        proxy_pass http://127.0.0.1:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:5050;
        add_header X-Content-Type-Options nosniff always;
    }
}
