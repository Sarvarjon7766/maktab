# TUMAN serveri (.env) — backend/.env ga nusxalang
APP_MODE=district
NODE_ENV=production
PORT=5050
TRUST_PROXY=1

MONGO_URI=mongodb://127.0.0.1:27017/faceid_district
# Har serverda alohida, tasodifiy, kamida 32 belgi (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_RANDOM_48_BYTES
HIK_SECRETS_KEY=CHANGE_ME_ANOTHER_RANDOM_48_BYTES

FRONTEND_URL=https://tuman.example.uz
CORS_ORIGINS=https://tuman.example.uz

# Bir serverda bir nechta tuman bo'lsa, viloyatga faqat shular beriladi (ixtiyoriy, vergul bilan)
# FEDERATION_DISTRICTS=Bulung'ur

# Aqlli kuzatuv (AI)
VISION_INTERVAL_SEC=30
# VISION_POSE_LIVE=0     # skelet tahlilini hodisa paytiga qoldirish (CPU tejaydi)
# VISION_VLM=1           # "AI ikkinchi fikri" (Ollama kerak)
