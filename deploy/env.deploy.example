# docker-compose uchun sozlamalar. Loyiha ildizida `.env` nomi bilan nusxalang (git'ga kirmaydi).
# JWT_SECRET: kamida 32 belgi, tasodifiy:   openssl rand -hex 32
JWT_SECRET=
# Hik-Connect kalitlarini shifrlash kaliti. MUHIM: eski serverdagi qiymat bilan BIR XIL bo'lsin
# (eski serverda yo'q bo'lsa — bo'sh qoldiring: u holda JWT_SECRET ishlatiladi, ya'ni JWT_SECRET ham ESKISI bilan bir xil bo'lishi shart)
HIK_SECRETS_KEY=
# ngrok manzilini bilgach to'ldiring (CORS uchun), masalan https://xxxx.ngrok-free.app
FRONTEND_URL=http://localhost:8088
WEB_PORT=8088
# GPU: cuda,cpu (Linux + NVIDIA). GPU ishlamasa avtomatik cpu ga o'tadi
AI_PROVIDER=cuda,cpu

# --- AI yuki va resurs chegaralari (ixtiyoriy; deploy/SERVER-SETUP.md 9-bo'lim) ---
# AI_WORKERS=1            # fon tahlil ishchi oqimlari (GPU serverda yadrolar soniga yaqin)
# AI_THREADS=             # har AI sessiyasi uchun yadrolar (bo'sh = yadrolarning yarmi)
# UV_THREADPOOL_SIZE=8    # Node ichki oqimlar puli (sharp, bcrypt, fayl)
# BACKEND_MEM_LIMIT=8g    # backend konteyneri xotira chegarasi
