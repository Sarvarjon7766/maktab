# VILOYAT serveri (.env) — backend/.env ga nusxalang
APP_MODE=region
NODE_ENV=production
PORT=5050
TRUST_PROXY=1

MONGO_URI=mongodb://127.0.0.1:27017/faceid_region
# Tuman serverlarinikidan BOSHQA qiymatlar
JWT_SECRET=CHANGE_ME_RANDOM_48_BYTES
# Tuman API kalitlarini bazada shifrlash uchun (o'zgarsa, tuman kalitlarini qayta kiritish kerak)
HIK_SECRETS_KEY=CHANGE_ME_ANOTHER_RANDOM_48_BYTES

FRONTEND_URL=https://viloyat.example.uz
CORS_ORIGINS=https://viloyat.example.uz

# Viloyat serverida kamera/AI/bot/hisobot fon vazifalari ishlamaydi (avtomatik)
